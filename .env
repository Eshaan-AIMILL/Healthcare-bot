# ── LLM ───────────────────────────────────────────────────────────────────────
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.1:8b-instruct-q8_0

# ── Database ──────────────────────────────────────────────────────────────────
DATABASE_URL=sqlite+aiosqlite:///./data/healthcare.db
CHROMA_PERSIST_DIR=./data/chroma

# ── Logging ───────────────────────────────────────────────────────────────────
LOG_LEVEL=INFO

# ── Seeder ────────────────────────────────────────────────────────────────────
SEED_ROWS_PER_TABLE=2000

# ── RAG ───────────────────────────────────────────────────────────────────────
RAG_CHUNK_SIZE=800
RAG_CHUNK_OVERLAP=120

# ── Email Alerts (configure before enabling) ──────────────────────────────────
# For Gmail: use an App Password (not your main password)
# Generate at: https://myaccount.google.com/apppasswords
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASSWORD=your-app-password
SMTP_FROM=healthbot-alerts@hospital.local
SMTP_USE_TLS=true

# Set to true once SMTP is configured above
ALERT_EMAILS_ENABLED=false
ALERT_CHECK_INTERVAL_MINUTES=60
