# ── LLM ───────────────────────────────────────────────────────────────────────
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.1:8b-instruct-q8_0

# ── Database ──────────────────────────────────────────────────────────────────
# PostgreSQL (production) — used by default:
DATABASE_URL=postgresql+asyncpg://healthcare:healthcare_pass@localhost:5432/healthcare
# SQLite (development fallback):
# DATABASE_URL=sqlite+aiosqlite:///./data/healthcare.db

# Connection Pool (PostgreSQL only, ignored for SQLite)
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=20
DB_POOL_RECYCLE=3600

# ChromaDB
CHROMA_PERSIST_DIR=./data/chroma

# ── Logging ───────────────────────────────────────────────────────────────────
LOG_LEVEL=INFO

# ── Seeder ────────────────────────────────────────────────────────────────────
SEED_ROWS_PER_TABLE=2000

# ── RAG ───────────────────────────────────────────────────────────────────────
RAG_CHUNK_SIZE=800
RAG_CHUNK_OVERLAP=120

# ── Email Alerts ──────────────────────────────────────────────────────────────
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=healthbot-alerts@hospital.local
SMTP_USE_TLS=true
ALERT_EMAILS_ENABLED=false
ALERT_CHECK_INTERVAL_MINUTES=60

# ── Security ──────────────────────────────────────────────────────────────────
# REQUIRED for production — set a strong, unique key:
OPENWEBUI_SECRET_KEY=
# If not set, a random key is auto-generated on each startup (dev only).

# ── CORS ──────────────────────────────────────────────────────────────────────
# Comma-separated allowed origins. Use "*" for development only.
CORS_ORIGINS=*
# Production example:
# CORS_ORIGINS=https://app.hospital.com,https://admin.hospital.com

# ── Rate Limiting ─────────────────────────────────────────────────────────────
RATE_LIMIT_CHAT=10/minute
RATE_LIMIT_DEFAULT=60/minute

# ── Gunicorn / Workers ────────────────────────────────────────────────────────
GUNICORN_WORKERS=4
GUNICORN_TIMEOUT=120

# ── Microservices URLs ────────────────────────────────────────────────────────
# BILLING_SERVICE_URL=http://billing-service:8002
# COMPLIANCE_SERVICE_URL=http://compliance-service:8003
# PHARMACY_SERVICE_URL=http://pharmacy-service:8004
# PATIENT_SERVICE_URL=http://patient-service:8005
# DISPATCH_SERVICE_URL=http://dispatch-service:8006
# CACHE_SERVICE_URL=http://cache-service:8007
BILLING_SERVICE_URL=http://localhost:8002
COMPLIANCE_SERVICE_URL=http://localhost:8003
PHARMACY_SERVICE_URL=http://localhost:8004
PATIENT_SERVICE_URL=http://localhost:8005
DISPATCH_SERVICE_URL=http://localhost:8006
CACHE_SERVICE_URL=http://localhost:8007

# ── Redis ─────────────────────────────────────────────────────────────────────
REDIS_URL=redis://localhost:6379/0

