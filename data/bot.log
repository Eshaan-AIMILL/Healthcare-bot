2026-05-30 00:38:08 | DEBUG    | app.tools.text2sql:run_text2sql:578 — Text2SQL [Attempt 1] | sql="WITH highest_rejected_insurance AS (\n    SELECT\n        payer_name,\n        COUNT(*) AS rejected_claims_count\n    FROM billing_claims\n    WHERE claim_status = 'Rejected'\n    GROUP BY payer_name\n    ORDER BY rejected_claims_count DESC\n    LIMIT 1\n),\nhigh_rejection_rate_codes AS (\n    WITH rejection_rates AS (\n        SELECT\n            primary_diagnosis_icd10,\n            secondary_diagnosis_icd10,\n            COUNT(*) FILTER (WHERE claim_status = 'Rejected') AS rejected_claims,\n            COUNT(*) AS total_claims\n        FROM billing_claims\n        GROUP BY primary_diagnosis_icd10, secondary_diagnosis_icd10\n    )\n    SELECT\n        primary_diagnosis_icd10,\n        secondary_diagnosis_icd10,\n        (rejected_claims * 100.0 / total_claims) AS rejection_rate_pct\n    FROM rejection_rates\n    WHERE rejection_rate_pct > 12 AND rejected_claims * claim_amount > 100000\n)\nSELECT\n    hri.payer_name,\n    SUM(bc.claim_amount) AS total_rejected_loss,\n    hrc.primary_diagnosis_icd10,\n    hrc.secondary_diagnosis_icd10,\n    hrc.rejection_rate_pct,\n    et.error_type\nFROM highest_rejected_insurance hri\nJOIN billing_claims bc ON hri.payer_name = bc.payer_name AND bc.claim_status = 'Rejected'\nLEFT JOIN high_rejection_rate_codes hrc ON bc.primary_diagnosis_icd10 = hrc.primary_diagnosis_icd10 AND bc.secondary_diagnosis_icd10 = hrc.secondary_diagnosis_icd10\nLEFT JOIN (\n    SELECT\n        primary_diagnosis_icd10,\n        secondary_diagnosis_ic10,\n        error_type,\n        COUNT(*) AS err_cnt,\n        ROW_NUMBER() OVER (PARTITION BY primary_diagnosis_icd10, secondary_diagnosis_ic10 ORDER BY COUNT(*) DESC) AS rn\n    FROM billing_claims\n    WHERE has_coding_error = 1 AND error_type IS NOT NULL AND error_type != ''\n    GROUP BY primary_diagnosis_icd10, secondary_diagnosis_ic10, error_type\n) et ON hrc.primary_diagnosis_icd10 = et.primary_diagnosis_icd10 AND hrc.secondary_diagnosis_ic10 = et.secondary_diagnosis_ic10 AND et.rn = 1\nGROUP BY hri.payer_name, hrc.rejection_rate_pct, hrc.primary_diagnosis_icd10, hrc.secondary_diagnosis_ic10, et.error_type\nORDER BY total_rejected_loss DESC\nLIMIT 1;" | params={'current_date': '2026-05-30'} | thinking_present=True
