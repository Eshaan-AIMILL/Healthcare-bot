2026-05-30 00:43:29 | DEBUG    | app.tools.text2sql:run_text2sql:578 — Text2SQL [Attempt 1] | sql="WITH rejection_rates AS (\n    SELECT\n        primary_diagnosis_icd10,\n        AVG(CASE WHEN claim_status = 'Rejected' THEN 100.0 ELSE 0.0 END) AS rejection_rate_pct,\n        SUM(CASE WHEN claim_status = 'Rejected' THEN claim_amount ELSE 0.0 END) AS total_rejected_claim_amount\n    FROM billing_claims bc\n    JOIN encounters e ON bc.encounter_id = e.encounter_id\n    GROUP BY primary_diagnosis_icd10\n    HAVING AVG(CASE WHEN claim_status = 'Rejected' THEN 100.0 ELSE 0.0 END) > 12 AND SUM(CASE WHEN claim_status = 'Rejected' THEN claim_amount ELSE 0.0 END) > 100000\n),\nerror_types AS (\n    SELECT\n        primary_diagnosis_icd10,\n        error_type,\n        COUNT(*) AS err_cnt,\n        ROW_NUMBER() OVER (PARTITION BY primary_diagnosis_icd10 ORDER BY COUNT(*) DESC) AS rn\n    FROM billing_claims bc\n    JOIN encounters e ON bc.encounter_id = e.encounter_id\n    WHERE has_coding_error = 1 AND error_type IS NOT NULL AND error_type != ''\n    GROUP BY primary_diagnosis_icd10, error_type\n)\nSELECT rr.primary_diagnosis_icd10,\n       rr.rejection_rate_pct,\n       rr.total_rejected_claim_amount,\n       et.error_type AS top_error_type\nFROM rejection_rates rr\nLEFT JOIN error_types et ON rr.primary_diagnosis_icd10 = et.primary_diagnosis_icd10 AND et.rn = 1\nORDER BY rr.rejection_rate_pct DESC, rr.total_rejected_claim_amount DESC\nLIMIT 1;" | params={'claim_amount': '100000.00', 'rejection_rate_pct': '12.00'} | thinking_present=True
