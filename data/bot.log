2026-05-30 01:07:42 | DEBUG    | app.tools.text2sql:run_text2sql:578 — Text2SQL [Attempt 1] | sql="WITH drug_inventory_data AS (\n    SELECT\n        d.drug_name,\n        di.current_stock,\n        di.max_stock_level,\n        d.category\n    FROM drugs d\n    JOIN drug_inventory di ON d.drug_id = di.drug_id\n    WHERE d.category IN ('Antibiotic', 'Cardiac')\n)\nSELECT\n    drug_name,\n    current_stock,\n    max_stock_level,\n    (current_stock / NULLIF(max_stock_level, 0)) AS safety_stock_index,\n    RANK() OVER (ORDER BY (current_stock / NULLIF(max_stock_level, 0)) ASC) AS risk_rank\nFROM drug_inventory_data\nORDER BY risk_rank;" | params={'param_name': 'value'} | thinking_present=True
