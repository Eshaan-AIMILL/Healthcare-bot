2026-05-30 00:49:42 | DEBUG    | app.tools.text2sql:run_text2sql:578 — Text2SQL [Attempt 1] | sql="WITH delay_calculation AS (\n    SELECT\n        cp.insurance_provider,\n        julianday(cp.procedure_date) - julianday(cp.created_at) AS processing_delay_days\n    FROM clinical_processes cp\n),\napproval_rejection_counts AS (\n    SELECT\n        dc.insurance_provider,\n        SUM(CASE WHEN c.status = 'Approved' THEN 1 ELSE 0 END) AS approved_count,\n        SUM(CASE WHEN c.status = 'Rejected' THEN 1 ELSE 0 END) AS rejected_count\n    FROM delay_calculation dc\n    JOIN claims c ON dc.process_id = c.process_id\n)\nSELECT\n    ac.insurance_provider,\n    AVG(ac.processing_delay_days) AS avg_processing_delay_days,\n    COALESCE((ac.approved_count::real / (ac.approved_count + ac.rejected_count)), 0) AS approval_to_rejection_ratio\nFROM approval_rejection_counts ac\nGROUP BY ac.insurance_provider\nORDER BY avg_processing_delay_days DESC;" | params={} | thinking_present=True
