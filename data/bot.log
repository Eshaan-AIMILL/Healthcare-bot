2026-05-30 00:37:47 | DEBUG    | app.tools.text2sql:run_text2sql:578 — Text2SQL [Attempt 1] | sql="WITH highest_rejected_insurance AS (\n    SELECT\n        insurance_company,\n        COUNT(CASE WHEN claim_status = 'Rejected' THEN 1 ELSE NULL END) AS rejected_count,\n        SUM(CASE WHEN claim_status = 'Rejected' THEN claim_amount ELSE 0 END) AS total_loss\n    FROM billing_claims\n    WHERE claim_status IN ('Approved', 'Rejected')\n    GROUP BY insurance_company\n    ORDER BY rejected_count DESC\n    LIMIT 1\n),\nhigh_rejection_rate_codes AS (\n    SELECT\n        diagnosis_code,\n        COUNT(CASE WHEN claim_status = 'Rejected' THEN 1 ELSE NULL END) / COUNT(*) * 100.0 AS rejection_rate,\n        SUM(CASE WHEN claim_status = 'Rejected' THEN claim_amount ELSE 0 END) AS total_rejected_amount,\n        has_coding_error\n    FROM billing_claims\n    WHERE claim_status = 'Rejected'\n    GROUP BY diagnosis_code, has_coding_error\n    HAVING rejection_rate > 12 AND total_rejected_amount > 100000\n)\nSELECT\n    hic.insurance_company,\n    hic.rejected_count,\n    hic.total_loss\nFROM highest_rejected_insurance hic\n\nUNION ALL\n\nSELECT\n    hrc.diagnosis_code,\n    hrc.rejection_rate,\n    hrc.total_rejected_amount,\n    hrc.has_coding_error AS common_coding_error_type\nFROM high_rejection_rate_codes hrc;" | params={'claim_status': 'Rejected', 'claim_status_1': 'Approved', 'rejection_rate': 12.0, 'total_rejected_amount': 100000} | thinking_present=True
